rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can read and write only their own progress document: users/{their user id}.
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['progress', 'updatedAt'])
        && request.resource.data.progress is string
        && request.resource.data.progress.size() < 900000;
    }
  }
}
